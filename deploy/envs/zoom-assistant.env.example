# Bot display name in Zoom meetings
BOT_NAME=AIAP Recorder

# AIAP Protocol transcription service URL
# When running in same Docker network as aiap-protocol:
AIAP_BASE_URL=http://aiap-protocol:8000
# When running standalone (outside Docker network):
# AIAP_BASE_URL=http://167.86.122.142/aiap

# App
APP_HOST=0.0.0.0
APP_PORT=8001
RECORDINGS_DIR=/tmp/zoom-recordings

# Browser
HEADLESS=true

# Recording
MAX_RECORDING_DURATION_SEC=14400
AUDIO_FORMAT=ogg
